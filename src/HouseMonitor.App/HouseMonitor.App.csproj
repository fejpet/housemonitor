<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HouseMonitor.Core\HouseMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <Target Name="BuildLinuxX11Stubs" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Exec Command="gcc -shared -fPIC &quot;$(ProjectDir)Native/ice_sm_stub.c&quot; -o &quot;$(OutputPath)libICE.so.6&quot; &amp;&amp; cp &quot;$(OutputPath)libICE.so.6&quot; &quot;$(OutputPath)libSM.so.6&quot;" />
  </Target>

</Project>
